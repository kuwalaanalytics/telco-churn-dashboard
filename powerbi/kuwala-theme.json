{
  "name": "Kuwala Analytics",
  "dataColors": ["#2F4B8F", "#E8590C", "#C9D4EA", "#F2C230", "#14213D", "#7C8699", "#1E8E5A", "#B7791F"],
  "background": "#FFFFFF",
  "foreground": "#141C33",
  "tableAccent": "#2F4B8F",
  "good": "#1E8E5A",
  "neutral": "#F2C230",
  "bad": "#E8590C",
  "maximum": "#E8590C",
  "center": "#F2C230",
  "minimum": "#2F4B8F",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#141C33" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#141C33" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4A556B" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#141C33" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F2F4F8" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "visualHeader": [{ "show": false }]
      }
    }
  }
}
